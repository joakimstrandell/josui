{
  "name": "@josui/tokens-preview",
  "version": "0.0.1",
  "bin": {
    "josui-tokens-preview": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/cli.mjs",
  "module": "./dist/cli.mjs",
  "types": "./dist/cli.d.mts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack src/cli.ts --dts --sourcemap && vite build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint src"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "chokidar": "^4.0.0",
    "commander": "^14.0.1",
    "hono": "^4.10.6",
    "open": "^10.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@josui/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
